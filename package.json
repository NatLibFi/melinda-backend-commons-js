{
	"name": "@natlibfi/melinda-backend-commons",
	"description": "Shared modules for Melinda's backend applications",
	"author": {
		"name": "The National Library of Finland"
	},
	"keywords": [],
	"homepage": "https://www.npmjs.com/package/@natlibfi/melinda-backend-commons",
	"bugs": {
		"url": "https://github.com/natlibfi/melinda-backend-commons-js/issues"
	},
	"repository": {
		"url": "https://github.com/NatLibFi/melinda-backend-commons-js"
	},
	"license": "MIT",
	"version": "3.0.5",
	"main": "./dist/index.js",
	"type": "module",
	"bin": {
		"gen-jwt-token": "./dist/gen-jwt-token.js",
		"gen-encryption-key": "./dist/gen-encryption-key.js",
		"mailer": "./dist/mailerCli.js"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc && npm run copyTemplates",
		"copyTemplates": "cd dist && mkdir -p templates && cp -iu ../src/templates/* ./templates/",
		"lint": "eslint ./src",
		"lint:dev": "eslint --fix ./src",
		"test:base": "node --test --experimental-test-coverage --test-reporter=spec './src/utils.test.ts'",
		"test": "npm run lint && npm run test:base",
		"watch:test": "cross-env DEBUG=@natlibfi/* NODE_ENV=test node --watch --test --experimental-test-coverage --test-reporter=spec './src/utils.test.ts'",
		"dev": "npm run watch:test",
		"dev:debug": "cross-env LOG_LEVEL=debug DEBUG=@natlibfi/* NODE_ENV=test npm run watch:test"
	},
	"dependencies": {
		"base64-url": "^2.3.3",
		"debug": "^4.4.3",
		"html-to-text": "^9.0.5",
		"moment": "^2.30.1",
		"morgan": "^1.10.1",
		"nodemailer": "^8.0.4",
		"winston": "^3.19.0",
		"yargs": "^18.0.0"
	},
	"devDependencies": {
		"@natlibfi/fixugen": "^4.0.0-alpha.1",
		"@natlibfi/fixura": "^5.0.0-alpha.4",
		"@types/node": "^25.6.0",
		"cross-env": "^10.1.0",
		"eslint": "^9.39.4",
		"jiti": "^2.6.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.2"
	}
}